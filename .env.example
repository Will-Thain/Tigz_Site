# Public site hostname used as Twitch embed `parent` (no https://)
NEXT_PUBLIC_SITE_HOST=localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twitch Helix (server only — never NEXT_PUBLIC)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_BROADCASTER_ID=438062587

# YouTube (optional; RSS works without a key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCKvHlvMpX7HMZ70w5Nyyz_w

# Optional TarkovTracker.org READ token only (PVP_ / PVE_ / SZN_). Never a write token.
TARKOVTRACKER_TOKEN=

# Postgres (polls, applications, published kits). Site runs on seed data without this.
DATABASE_URL=

# Resend for sponsor applications. Without it, the form still mailto:s Mythic Talent.
RESEND_API_KEY=
RESEND_FROM=hub@yourdomain.com
SPONSOR_TO=Tigz@mythictalent.com

# Optional admin gate
ADMIN_PASSWORD=

# Cloudflare Turnstile (polls + sponsor form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
